SERPAPI_API_KEY=
# Optional pause between Google-result pages. Do not put credentials in source.
SERPAPI_DELAY_SECONDS=0.2
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1
# Required only for Workflow 3. Must support xAI Responses API web_search.
XAI_WEB_MODEL=grok-4.7
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
MAX_RESULTS_PER_PROVIDER=100
