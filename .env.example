# Required credential
XAI_API_KEY=

# Optional date overrides; CLI arguments take precedence.
START_DATE=
END_DATE=

# Optional runtime configuration
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
OUTPUT_DIR=output
HTTP_TIMEOUT_SECONDS=25
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
GOOGLE_DELAY_MS=1200
GOOGLE_HOME_WAIT_MS=2500
# auto prefers an installed normal Chrome/Chromium; use chromium in CI.
BROWSER_CHANNEL=auto
# Optional explicit local executable path, e.g. /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_EXECUTABLE_PATH=
# Stable dedicated profile; do not point this at your personal Chrome profile.
BROWSER_PROFILE_DIR=.cache/google-profile
